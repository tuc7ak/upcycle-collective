ORGANISER_PRIVATE_KEY=your_base58_private_key_here
TOKEN_MINT=mint_address_after_deploy
HELIUS_RPC=https://mainnet.helius-rpc.com/?api-key=your_key
PRIVY_APP_ID=your_privy_app_id_here

# Vendor wallet PUBLIC addresses (not private keys — vendors only need to receive TUC)
VENDOR_LANDIK=vendor_phantom_wallet_address_here
VENDOR_UITM=vendor_phantom_wallet_address_here
VENDOR_BEER=vendor_phantom_wallet_address_here
VENDOR_CLOTHES_SWAP=vendor_phantom_wallet_address_here
VENDOR_CREATIVE=vendor_phantom_wallet_address_here

# Ticketing (Stripe + Lomeo) — for "The Spring - The WAK - TUC Event"
# 1. Set STRIPE_SECRET_KEY, then run: npm run setup-tickets
# 2. Paste the 3 price IDs it prints below
# 3. In the Stripe Dashboard, toggle each price on as a ticket via the Lomeo app
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_PRICE_STUDENT=price_id_after_setup
STRIPE_PRICE_NORMAL=price_id_after_setup
STRIPE_PRICE_PREMIUM=price_id_after_setup
# Optional — only needed if the deployed origin/host header isn't reliable
PUBLIC_SITE_URL=https://your-domain.example
